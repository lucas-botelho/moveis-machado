# Public origin of the site, without a trailing slash. Used for canonical URLs,
# hreflang, Open Graph, sitemap.xml and robots.txt.
# Production: https://armandomachado.pt (set as the SITE_URL repository variable in CI).
# Leave empty to use the GitHub Pages address.
VITE_SITE_URL=

# Optional: token from Google Search Console ("HTML tag" verification method).
# Not needed when the property is verified by DNS.
VITE_GOOGLE_SITE_VERIFICATION=
